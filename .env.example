# Copiez en .env pour le développement local. Ne commitez jamais .env.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
FRONTEND_URL=
# Base de données (vide = SQLite locale). Neon : postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=
NEON_DATABASE_URL=
DATABASE_SSL_REQUIRE=true
DATABASE_POOLED=false
REDIS_URL=
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
# E-mail via l'API Brevo (HTTPS). Sans BREVO_API_KEY : affichage console en dev. Voir BREVO_SETUP.md
BREVO_API_KEY=
MAIL_FROM=INDPNS Market <no-reply@indpns.com>
# BREVO_TIMEOUT=15
# Ancien nom de l'expéditeur, utilisé seulement si MAIL_FROM est vide
DEFAULT_FROM_EMAIL=
# SMTP historique (repli facultatif, non requis avec Brevo)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Stockage S3 compatible (vide = fichiers locaux)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
DOWNLOAD_LINK_TTL=300
# Paiements (vide = mode catalogue : encaissement désactivé)
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=false

# Vérification d'identité : clé de chiffrement des documents (obligatoire en production si SECRET_KEY n'est pas fixe)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_ENCRYPTION_KEY=
KYC_PURGE_DOCS_ON_APPROVAL=false
PAYOUT_HOLD_DAYS=14
MIN_PAYOUT_AMOUNT=20.00
SUBSCRIPTIONS_ENABLED=false
# OAuth (architecture prête, inactif sans clés)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
# Antivirus ClamAV (optionnel)
ANTIVIRUS_ENABLED=false
ANTIVIRUS_REQUIRED=false
ANTIVIRUS_CLAMD_HOST=127.0.0.1
ANTIVIRUS_CLAMD_PORT=3310
# Divers
ADMIN_URL=admin/
SENTRY_DSN=
BOOTSTRAP_MIGRATIONS=0
